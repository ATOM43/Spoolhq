{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpoolHQ",
  "version": "0.0.0",
  "identifier": "dev.spoolhq.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpoolHQ",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/spoolhq"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RUJDQjM2NTUxQzU4NjMKUldSaldCeFZOc3ZyUjJIV1dtWE41MndTV3hLdDJLc2lUQjhpVmZtRW4zd0NYVENuQVFsbFhLR0QK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/ATOM43/Spoolhq/releases/latest/download/latest.json"
      ]
    }
  }
}
